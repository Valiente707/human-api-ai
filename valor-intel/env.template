# Valor Intel — API keys and credentials
# Copy this file to ~/.config/valor-intel/env, fill in the values, and
# source it from your shell rc:
#
#     mkdir -p ~/.config/valor-intel
#     cp valor-intel/env.template ~/.config/valor-intel/env
#     chmod 600 ~/.config/valor-intel/env
#     # then edit ~/.config/valor-intel/env and add:
#     echo '[ -r ~/.config/valor-intel/env ] && source ~/.config/valor-intel/env' >> ~/.zshrc
#     source ~/.zshrc
#
# Or run ./install-skills.sh which sets all of this up except editing
# the values. NEVER commit a filled-in copy of this file. The repo's
# .gitignore protects against accidental commits.
#
# Get each key from the URL noted next to it. Setup time / cost details
# are in valor-intel-playbook.md §1a.
# ---------------------------------------------------------------------

# ---- Tier 2: Bluesky (free, app password) ----------------------------
# https://bsky.app/settings/app-passwords
export BLUESKY_HANDLE=""              # e.g. you.bsky.social
export BLUESKY_APP_PASSWORD=""        # xxxx-xxxx-xxxx-xxxx

# ---- Tier 3: ScrapeCreators (free 10K calls/month) -------------------
# https://scrapecreators.com — covers TikTok, Instagram, Threads, Pinterest
export SCRAPECREATORS_API_KEY=""

# ---- Tier 3: OpenRouter / Perplexity Sonar Pro (pay-as-you-go) -------
# https://openrouter.ai — required for Q5/Q6/Q10 (Compliance lens)
export OPENROUTER_API_KEY=""

# ---- Tier 3: Brave Search (free 2K queries/month) --------------------
# https://brave.com/search/api
export BRAVE_API_KEY=""

# ---- Slack webhook (FALLBACK only — Slack MCP is the primary path) ---
# Leave blank unless you're setting up headless automation. Setup at
# https://api.slack.com/apps -> Incoming Webhooks. Channel-locked URL.
# export SLACK_WEBHOOK_URL=""

# ---- Runtime: enable all 13 sources for /last30days ------------------
# Cross-check the source-name tokens against
#     ~/.claude/skills/last30days/README.md
# if anything misbehaves. Listed names are best-guess as of repo write.
export INCLUDE_SOURCES="x,youtube,bluesky,tiktok,instagram,threads,pinterest,perplexity,web"
